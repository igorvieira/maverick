{
  "schema_version": 1,
  "id": "rails",
  "display_name": "Rails",
  "detection": {
    "files": [
      "Gemfile",
      "config/application.rb"
    ],
    "any_files": []
  },
  "commands": {
    "test": "bin/rails test",
    "lint": "bundle exec rubocop"
  },
  "agents": {
    "planner": "rails-task-scope-planner",
    "implementer": "rails-implementer",
    "red_team": "rails-adversarial-architect"
  },
  "reviewers": [
    {
      "id": "idiom",
      "agent": "rails-idiom-reviewer",
      "always": true,
      "capabilities": [],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "domain",
      "agent": "rails-domain-reviewer",
      "always": false,
      "capabilities": [
        "domain"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "application_flow",
      "agent": "rails-application-flow-reviewer",
      "always": false,
      "capabilities": [
        "application_flow"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "adapter",
      "agent": "rails-adapter-reviewer",
      "always": false,
      "capabilities": [
        "adapters",
        "api_contract",
        "database"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "eventing",
      "agent": "rails-eventing-reviewer",
      "always": false,
      "capabilities": [
        "eventing"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "architecture",
      "agent": "rails-arch-reviewer",
      "always": false,
      "capabilities": [
        "architecture",
        "transaction_boundaries",
        "cross_service_consistency",
        "concurrency"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    }
  ],
  "red_team": {
    "always": false,
    "capabilities": [
      "domain",
      "eventing",
      "aggregate_design",
      "transaction_boundaries",
      "cross_service_consistency",
      "eventing_strategy"
    ],
    "blocking": {
      "statuses": [
        "fail"
      ],
      "severities": [
        "blocker",
        "high"
      ]
    },
    "legacy_verdicts": {
      "Architecture holds under scrutiny": "pass",
      "Architecture holds with identified risks": "warn",
      "Architecture has critical flaws": "fail"
    }
  },
  "review_policy": {
    "max_fix_rounds": 3,
    "rerun_blocked_only": true,
    "resolve_warnings": true
  }
}
