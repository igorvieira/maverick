{
  "schema_version": 1,
  "id": "python",
  "display_name": "Python",
  "detection": {
    "files": [],
    "any_files": [
      "pyproject.toml",
      "requirements.txt",
      "setup.py"
    ]
  },
  "commands": {
    "format": "ruff format .",
    "lint": "ruff check .",
    "test": "pytest"
  },
  "agents": {
    "planner": "python-task-scope-planner",
    "implementer": "python-implementer",
    "red_team": "python-adversarial-architect"
  },
  "reviewers": [
    {
      "id": "idiom",
      "agent": "python-idiom-reviewer",
      "always": true,
      "capabilities": [],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "domain",
      "agent": "python-domain-reviewer",
      "always": false,
      "capabilities": [
        "domain"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "application_flow",
      "agent": "python-application-flow-reviewer",
      "always": false,
      "capabilities": [
        "application_flow"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "adapter",
      "agent": "python-adapter-reviewer",
      "always": false,
      "capabilities": [
        "adapters",
        "api_contract",
        "database"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "eventing",
      "agent": "python-eventing-reviewer",
      "always": false,
      "capabilities": [
        "eventing"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    },
    {
      "id": "architecture",
      "agent": "python-arch-reviewer",
      "always": false,
      "capabilities": [
        "architecture",
        "transaction_boundaries",
        "cross_service_consistency",
        "concurrency"
      ],
      "blocking": {
        "statuses": [
          "fail"
        ],
        "severities": [
          "blocker",
          "high"
        ]
      }
    }
  ],
  "red_team": {
    "always": false,
    "capabilities": [
      "domain",
      "eventing",
      "aggregate_design",
      "transaction_boundaries",
      "cross_service_consistency",
      "eventing_strategy"
    ],
    "blocking": {
      "statuses": [
        "fail"
      ],
      "severities": [
        "blocker",
        "high"
      ]
    },
    "legacy_verdicts": {
      "Architecture holds under scrutiny": "pass",
      "Architecture holds with identified risks": "warn",
      "Architecture has critical flaws": "fail"
    }
  },
  "review_policy": {
    "max_fix_rounds": 3,
    "rerun_blocked_only": true,
    "resolve_warnings": true
  }
}
